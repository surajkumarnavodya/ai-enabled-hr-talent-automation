CLAUDE.local.md
.claude/settings.local.json

# === Logs & telemetry (never commit runtime logs — may contain sensitive data) ===
*.log
logs/
otel-collector-data/

# === OS ===
.DS_Store
Thumbs.db

# === Temp files ===
*.tmp
*.temp
~$*

# === Terraform / IaC state (never commit state — contains secrets/infra data) ===
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# === Sensitive generated reports ===
**/pii-scan-*.json
**/security-scan-*.sarif
**/*-CONFIDENTIAL.*

# === HR documents & candidate/employee uploads (never commit real content) ===
uploads/
documents/

# === AI / RAG / agent runtime data (generated, may contain sensitive source content) ===
vector-store/
embeddings/
rag-data/
agent-runs/
prompt-logs/

# === Publish output ===
publish/

# === Crash dumps ===
*.dmp
