# =============================================================================
# HrAutomation.Web — environment variable template. SAFE PLACEHOLDERS ONLY.
# Copy to .env.local (gitignored) and adjust. Every var must be prefixed VITE_
# to be exposed to client code by Vite — never put a secret behind VITE_*,
# since anything with that prefix is bundled into the public JS output.
# See README.md "Environment variables" and docs/05-security-governance/frontend-security.md.
# =============================================================================

# Deployment context (dev | test | staging | prod) — drives non-secret behavioral defaults only.
VITE_APP_ENV=dev

# Base URL the API client targets. In local dev, requests to /api/* are proxied by
# Vite (see vite.config.ts) to VITE_API_PROXY_TARGET, so this can stay same-origin.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000

# Only read by vite.config.ts at dev-server start (not bundled into client code).
VITE_API_PROXY_TARGET=http://localhost:5219

# Auth provider selection — see src/features/auth/authProviderFactory.ts.
#   mock     : local-only synthetic identities, no network calls, no real API can be reached
#              with the resulting token — use only together with VITE_ENABLE_MSW=true.
#   devToken : calls HrAutomation.Api's real, Development-only /api/v1/dev/token endpoint to get
#              a real signed JWT the real backend accepts — real API/database calls, dev auth only.
#   oidc     : real OAuth 2.1 / OIDC provider (authority/client id below), or a BFF cookie
#              session per docs/05-security-governance/frontend-security.md — NEVER a client secret.
#              Not implemented yet (see features/auth/oidcAuthProvider.ts).
VITE_AUTH_MODE=devToken
VITE_OIDC_AUTHORITY=https://login.example-tenant.invalid/
VITE_OIDC_CLIENT_ID=__set_per_env__
VITE_OIDC_REDIRECT_URI=http://localhost:5173/login

# Enables the MSW mock service worker. Default OFF — normal runtime must hit the real API.
# Only set true for isolated component/demo development with VITE_AUTH_MODE=mock. Ignored
# (forced off) in production regardless of this value — see app/config/appConfig.ts.
VITE_ENABLE_MSW=false

# Display timezone for all date/time rendering (see lib/dateUtils.ts). Configurable
# per docs/00-product placeholders for localization/timezone settings.
VITE_DEFAULT_TIMEZONE=UTC

# Optional OTLP-compatible collector endpoint for frontend telemetry (traces/metrics
# only — see lib/safeLogger.ts; never sends PII, documents, or token values).
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
