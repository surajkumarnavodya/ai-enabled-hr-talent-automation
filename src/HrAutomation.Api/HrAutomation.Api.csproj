<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ee90fcc8-70e7-49be-9f6f-5b830ba33368</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HrAutomation.Domain\HrAutomation.Domain.csproj" />
    <ProjectReference Include="..\HrAutomation.Application\HrAutomation.Application.csproj" />
    <ProjectReference Include="..\HrAutomation.Infrastructure\HrAutomation.Infrastructure.csproj" />
    <ProjectReference Include="..\HrAutomation.Agents\HrAutomation.Agents.csproj" />
    <ProjectReference Include="..\HrAutomation.Rag\HrAutomation.Rag.csproj" />
    <ProjectReference Include="..\HrAutomation.Mcp\HrAutomation.Mcp.csproj" />
  </ItemGroup>

</Project>
