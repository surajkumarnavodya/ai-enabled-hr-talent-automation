# =============================================================================
# ENVIRONMENT VARIABLE TEMPLATE — SAFE PLACEHOLDERS ONLY
# Never commit a real .env file. Copy this to .env locally and fill in values
# from your own dev setup. Production values live in the secret vault
# referenced by KEY_VAULT_URI — never as literals here or in .env.
# See docs/05-security-governance/secrets-and-key-management.md.
# =============================================================================

# --- General ---
APP_ENVIRONMENT=dev                            # dev | test | staging | prod

# --- Relational database (system of record) ---
# Never a literal password in a committed file — this is a local-dev-only placeholder.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=hr_automation_dev;Username=hr_automation_dev;Password=__set_locally_never_commit__

# --- HrAutomation.Api (EF Core / SQL Server, database-first against HrAutomationDb) ---
# The double-underscore form is the ASP.NET Core convention for nested config keys
# (ConnectionStrings__HrAutomationDb -> ConnectionStrings:HrAutomationDb) and is read by both
# the running API (Program.cs) and the EF Core design-time factory (HrAutomationDbContextFactory.cs).
# Prefer `dotnet user-secrets set "ConnectionStrings:HrAutomationDb" "..."` from
# src/HrAutomation.Api for local dev instead of an actual .env file — it never touches
# a file that could be committed. This env var exists for CI/containers/other environments.
ConnectionStrings__HrAutomationDb=Server=(localdb)\MSSQLLocalDB;Database=HrAutomationDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- Cache / distributed locks ---
REDIS_CONNECTION_STRING=localhost:6379

# --- Object storage (documents, CVs, offer letters) ---
OBJECT_STORAGE_PROVIDER=azure_blob             # azure_blob | s3 | gcs
OBJECT_STORAGE_ENDPOINT=https://__set_per_env__.blob.core.windows.net
OBJECT_STORAGE_CONTAINER=hr-documents

# --- Vector database (approved retrieval content only — never system of record) ---
VECTOR_DB_PROVIDER=pgvector                    # pgvector | azure_ai_search | qdrant | pinecone | weaviate
VECTOR_DB_ENDPOINT=https://__set_per_env__.invalid
VECTOR_DB_INDEX=hr-policy-rag

# --- Identity (OAuth 2.1 / OpenID Connect) ---
IDENTITY_AUTHORITY=https://login.example-tenant.invalid/
IDENTITY_AUDIENCE=api://hr-automation

# --- Secret vault ---
KEY_VAULT_URI=https://__set_per_env__.vault.azure.invalid/

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- LLM / model provider ---
LLM_PROVIDER=anthropic                         # anthropic | azure_openai | openai | other
LLM_MODEL_PRIMARY=__set_per_env__              # e.g. a mid-reasoning tier model id
LLM_MODEL_FALLBACK=__set_per_env__             # e.g. a small/fast tier model id

# --- MCP servers (each isolated and independently authenticated — see mcp/) ---
MCP_CALENDAR_SERVER_URL=https://mcp-calendar.internal.invalid
MCP_EMAIL_SERVER_URL=https://mcp-email.internal.invalid
MCP_HRMS_SERVER_URL=https://mcp-hrms.internal.invalid
# Additional MCP servers referenced in mcp/servers/README.md — add as each is provisioned:
# MCP_ESIGNATURE_SERVER_URL=https://mcp-esignature.internal.invalid
# MCP_PAYROLL_SERVER_URL=https://mcp-payroll.internal.invalid
# MCP_IT_PROVISIONING_SERVER_URL=https://mcp-itprov.internal.invalid
# MCP_DOCUMENT_MGMT_SERVER_URL=https://mcp-docmgmt.internal.invalid
# MCP_BACKGROUND_VERIFICATION_SERVER_URL=https://mcp-bgv.internal.invalid

# --- Feature flags ---
FEATURE_FLAGS_SOURCE=config/defaults/platform.default.yaml   # or a remote flag service endpoint
